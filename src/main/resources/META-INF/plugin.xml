<idea-plugin>
    <!-- 插件唯一标识，必须是 FQN，发布后不能再改 -->
    <id>com.example.view-txt</id>

    <name>View Txt</name>

    <vendor url="">makabaka</vendor>

    <description><![CDATA[
        <p>ide内快捷查看文本文件</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!-- 资源包路径，与 ViewTxtBundle.kt 中的 BUNDLE 常量保持一致 -->
    <resource-bundle>messages.ViewTxtBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 工具窗口 id 被 ViewTxtBundle.properties 的 toolwindow.stripe.MyToolWindow 引用，不可随意改 -->
        <toolWindow id="MyToolWindow" factoryClass="com.example.viewtxt.ViewTxtToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <projectService serviceImplementation="com.example.viewtxt.FileStateService"/>
        <action id="com.example.viewtxt.MultiKeyPressAction" class="com.example.viewtxt.MultiKeyPressAction"
                text="Show File Content Popup" description="Show the content of the selected file in a popup">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
        <editorFactoryListener topic="com.intellij.openapi.editor.event.EditorFactoryListener"
                               implementation="com.example.viewtxt.KeyTypedListener"/>
    </extensions>
</idea-plugin>
